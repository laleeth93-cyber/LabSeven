generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                        Int                        @id @default(autoincrement())
  name                      String
  email                     String?                    @unique
  phone                     String?
  address                   String?
  plan                      String                     @default("Free Trial")
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now()) @updatedAt
  subscriptionEndsAt        DateTime?
  hasSensitivity            Boolean                    @default(false)
  whatsappReportAuto        Boolean                    @default(false)
  whatsappReportManual      Boolean                    @default(true)
  whatsappInvoiceAuto       Boolean                    @default(false)
  whatsappInvoiceManual     Boolean                    @default(true)
  whatsappAdminAlertAuto    Boolean                    @default(false)
  whatsappAdminAlertManual  Boolean                    @default(true)
  whatsappLimit             Int                        @default(0)
  supportKeyHash            String?

  antibiotics               Antibiotic[]
  antibioticClasses         AntibioticClass[]
  antibioticInterpretations AntibioticInterpretation[]
  bills                     Bill[]
  billItems                 BillItem[]
  departments               Department[]
  doctors                   Doctor[]
  labLists                  LabList[]
  labProfiles               LabProfile[]
  methods                   Method[]
  operators                 Operator[]
  organisms                 Organism[]
  parameters                Parameter[]
  parameterRanges           ParameterRange[]
  patients                  Patient[]
  payments                  Payment[]
  reportSettings            ReportSettings[]
  roles                     Role[]
  specimens                 Specimen[]
  supportThreads            SupportThread[]
  susceptibilityInfos       SusceptibilityInfo[]
  tests                     Test[]
  testParameters            TestParameter[]
  testResults               TestResult[]
  uoms                      UOM[]
  users                     User[]
  vacutainers               Vacutainer[]
  whatsappAccounts          WhatsAppAccount[]
  whatsappLogs              WhatsAppLog[]
  whatsappQueues            WhatsAppQueue[]
  whatsappAuditLogs         WhatsAppAuditLog[]
}

model Patient {
  id             Int          @id @default(autoincrement())
  patientId      String
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  designation    String?
  firstName      String
  lastName       String
  gender         String
  ageY           Int?         @default(0)
  ageM           Int?         @default(0)
  ageD           Int?         @default(0)
  weight         String?
  height         String?
  phone          String
  email          String?
  address        String?
  aadhaar        String?
  uhid           String?
  passport       String?
  referralType   String?
  refDoctor      String?
  collectionAt   String?
  bills          Bill[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, patientId])
  @@index([organizationId])
  @@index([phone])
}

model Bill {
  id              Int          @id @default(autoincrement())
  billNumber      String
  organizationId  Int
  date            DateTime     @default(now())
  patientId       Int
  doctorId        Int?
  approvedBy1Id   Int?
  approvedBy2Id   Int?
  subTotal        Float
  discountPercent Float?
  discountAmount  Float?
  discountReason  String?
  netAmount       Float
  paidAmount      Float
  dueAmount       Float
  isFullyPaid     Boolean      @default(false)
  isDeleted       Boolean      @default(false)
  approvedBy1     User?        @relation("BillApprovedBy1", fields: [approvedBy1Id], references: [id])
  approvedBy2     User?        @relation("BillApprovedBy2", fields: [approvedBy2Id], references: [id])
  doctor          Doctor?      @relation(fields: [doctorId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id])
  items           BillItem[]
  payments        Payment[]

  @@unique([organizationId, billNumber])
  @@index([organizationId, date])
  @@index([patientId])
}

model BillItem {
  id             Int          @id @default(autoincrement())
  organizationId Int
  billId         Int
  testId         Int
  price          Float
  isUrgent       Boolean      @default(false)
  status         String       @default("Pending")
  notes          String?
  bill           Bill         @relation(fields: [billId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  test           Test         @relation(fields: [testId], references: [id])
  results        TestResult[]

  @@index([organizationId])
  @@index([billId])
  @@index([testId])
}

model TestResult {
  id             Int          @id @default(autoincrement())
  organizationId Int
  billItemId     Int
  parameterId    Int?
  resultValue    String?
  flag           String?
  remarks        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  billItem       BillItem     @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parameter      Parameter?   @relation(fields: [parameterId], references: [id])

  @@index([organizationId])
  @@index([billItemId])
  @@index([parameterId])
}

model Payment {
  id             Int          @id @default(autoincrement())
  organizationId Int
  billId         Int
  mode           String
  amount         Float
  transactionId  String?
  date           DateTime     @default(now())
  bill           Bill         @relation(fields: [billId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([billId])
}

model Doctor {
  id              Int          @id @default(autoincrement())
  organizationId  Int
  type            String       @default("Doctor")
  name            String
  code            String?
  hospital        String?
  degree          String?
  commission      Float?       @default(0)
  contactPerson   String?
  phone           String?
  email           String?
  specialization  String?
  clinicName      String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  bills           Bill[]
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outsourcedTests Test[]       @relation("TestOutsourceLab")
  user            User?
}

model Test {
  id                     Int             @id @default(autoincrement())
  code                   String
  organizationId         Int
  name                   String
  displayName            String?
  price                  Float           @default(0)
  departmentId           Int?
  methodId               Int?
  specimenId             Int?
  vacutainerId           Int?
  gender                 String?         @default("Both")
  type                   String          @default("Test")
  description            String?
  sampleVolume           String?
  barcodeCopies          Int?            @default(1)
  minDays                Int?            @default(0)
  minHours               Int?            @default(0)
  minMinutes             Int?            @default(0)
  maxDays                Int?            @default(0)
  maxHours               Int?            @default(0)
  maxMinutes             Int?            @default(0)
  resultType             String?         @default("Parameter")
  template               String?         @default("Default")
  instructions           String?
  isInterpretationNeeded Boolean         @default(false)
  interpretation         String?
  reportTitle            String?
  colCaption1            String?
  colCaption2            String?
  colCaption3            String?
  colCaption4            String?
  colCaption5            String?
  labEquiName            String?
  isFormulaNeeded        Boolean         @default(false)
  isCountNeeded          Boolean         @default(false)
  targetCount            Int?
  lmpRequired            Boolean         @default(false)
  idRequired             Boolean         @default(false)
  consentRequired        Boolean         @default(false)
  printNextPage          Boolean         @default(false)
  billingOnly            Boolean         @default(false)
  isCulture              Boolean         @default(false)
  cultureColumns         String?
  isOutsourced           Boolean         @default(false)
  outsourceLabId         Int?
  isConfigured           Boolean         @default(false)
  isActive               Boolean         @default(true)
  normalRange            String?
  units                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
  showTestNameOnReport   Boolean         @default(false)
  billItems              BillItem[]
  packageTests           PackageTest[]   @relation("PackageToTests")
  partOfPackages         PackageTest[]   @relation("TestInPackages")
  department             Department?     @relation(fields: [departmentId], references: [id])
  method                 Method?         @relation(fields: [methodId], references: [id])
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outsourceLab           Doctor?         @relation("TestOutsourceLab", fields: [outsourceLabId], references: [id])
  specimen               Specimen?       @relation(fields: [specimenId], references: [id])
  vacutainer             Vacutainer?     @relation(fields: [vacutainerId], references: [id])
  parameters             TestParameter[]

  @@unique([organizationId, code])
}

model PackageTest {
  id        Int  @id @default(autoincrement())
  packageId Int
  testId    Int
  package   Test @relation("PackageToTests", fields: [packageId], references: [id], onDelete: Cascade)
  test      Test @relation("TestInPackages", fields: [testId], references: [id], onDelete: Cascade)

  @@unique([packageId, testId])
}

model TestParameter {
  id               Int          @id @default(autoincrement())
  organizationId   Int
  testId           Int
  parameterId      Int?
  order            Int          @default(0)
  isHeading        Boolean      @default(false)
  headingText      String?
  isCultureField   Boolean      @default(false)
  isActive         Boolean      @default(true)
  formula          String?
  isCountDependent Boolean      @default(false)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parameter        Parameter?   @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  test             Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Parameter {
  id              Int              @id @default(autoincrement())
  organizationId  Int
  name            String
  displayName     String?
  code            String?
  department      String?          @default("HEMATOLOGY")
  price           Float?           @default(0)
  unit            String?
  method          String?
  inputType       String           @default("Numerical")
  decimals        Int?             @default(2)
  resultAlignment String?          @default("Beside")
  isMultiValue    Boolean          @default(false)
  options         String[]
  reportTitle     String?
  colCaption1     String?
  colCaption2     String?
  colCaption3     String?
  colCaption4     String?
  colCaption5     String?
  isFormula       Boolean          @default(false)
  billingOnly     Boolean          @default(false)
  gender          String?          @default("Both")
  minAge          Int?             @default(0)
  maxAge          Int?             @default(100)
  ageUnit         String?          @default("Years")
  minVal          Float?
  maxVal          Float?
  criticalLow     Float?
  criticalHigh    Float?
  lowMessage      String?
  highMessage     String?
  panicMessage    String?
  interpretation  String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ranges          ParameterRange[]
  tests           TestParameter[]
  results         TestResult[]

  @@unique([organizationId, code])
}

model ParameterRange {
  id               Int          @id @default(autoincrement())
  organizationId   Int
  parameterId      Int
  gender           String       @default("Both")
  minAge           Int          @default(0)
  maxAge           Int          @default(100)
  minAgeUnit       String       @default("Years")
  maxAgeUnit       String       @default("Years")
  normalOperator   String       @default("Between")
  lowRange         Float?
  highRange        Float?
  normalRange      String?
  normalValue      String?
  abnormalValue    String?
  criticalOperator String       @default("Between")
  criticalLow      Float?
  criticalHigh     Float?
  criticalValue    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parameter        Parameter    @relation(fields: [parameterId], references: [id], onDelete: Cascade)
}

model Department {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tests          Test[]

  @@unique([organizationId, code])
}

model Specimen {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  type           String?
  container      String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tests          Test[]

  @@unique([organizationId, code])
}

model Vacutainer {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  color          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  tests          Test[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model Method {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tests          Test[]

  @@unique([organizationId, code])
}

model UOM {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model Operator {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  symbol         String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model LabList {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  values         String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model LabProfile {
  id             Int          @id @default(autoincrement())
  organizationId Int
  name           String       @default("Lab Seven")
  tagline        String?
  address        String       @default("123 Health Avenue, Medical District")
  phone          String       @default("+1 234 567 890")
  email          String?
  website        String?
  logoUrl        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  letterheadUrl  String?
  lhHeight       String?
  lhMb           String?
  lhMl           String?
  lhMr           String?
  lhMt           String?
  lhWidth        String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ReportSettings {
  id                  Int          @id @default(autoincrement())
  organizationId      Int
  doc1Name            String?      @default("Dr. John Doe")
  doc1Designation     String?      @default("Chief Pathologist")
  doc1SignUrl         String?
  doc2Name            String?
  doc2Designation     String?
  doc2SignUrl         String?
  marginTop           Int          @default(120)
  marginBottom        Int          @default(80)
  marginLeft          Int          @default(40)
  marginRight         Int          @default(40)
  marginSettings      String?
  tableStyle          String       @default("grid")
  fontFamily          String       @default("font-sans")
  fontSize            String       @default("text-xs")
  rowPadding          String       @default("py-1.5")
  labelBold           Boolean      @default(true)
  dataBold            Boolean      @default(false)
  leftColFields       String?
  rightColFields      String?
  leftColWidth        String       @default("35 65")
  rightColWidth       String       @default("35 65")
  headerQrCode        Boolean      @default(false)
  showMethodCol       Boolean      @default(true)
  methodDisplayStyle  String       @default("column")
  showUnitCol         Boolean      @default(true)
  showRefRangeCol     Boolean      @default(true)
  highlightAbnormal   Boolean      @default(true)
  stripedRows         Boolean      @default(false)
  testColumnWidth     String       @default("auto")
  colWidthParam       String?
  colWidthResult      String?
  colWidthUnit        String?
  colWidthRef         String?
  colWidthMethod      String?
  bodyTableStyle      String       @default("horizontal")
  bodyFontFamily      String       @default("font-sans")
  bodyFontSize        String       @default("text-sm")
  bodyRowHeight       String       @default("py-2")
  bodyColPadding      String       @default("px-2")
  bodyHeaderBgColor   String       @default("bg-slate-50")
  bodyHeaderTextColor String       @default("text-slate-800")
  bodyResultAlign     String       @default("text-left")
  showDepartmentName  Boolean      @default(true)
  departmentNameSize  String       @default("text-sm")
  testNameAlignment   String       @default("text-center")
  testNameUnderline   Boolean      @default(true)
  testNameSize        String       @default("text-base")
  gridLineThickness   String       @default("1")
  subheadingColor     String       @default("#5e35b1")
  subheadingSize      String       @default("text-sm")
  footerStyle         String       @default("style1")
  sigSize             Int          @default(40)
  sigSpacing          Int          @default(4)
  docNameSize         Int          @default(10)
  docDesigSize        Int          @default(8)
  docNameSpacing      Int          @default(2)
  sigAlignment        String       @default("center")
  showQrCode          Boolean      @default(true)
  showBarcode         Boolean      @default(false)
  showPageNumbers     Boolean      @default(true)
  showEndOfReport     Boolean      @default(true)
  qrPlacement         String       @default("footer")
  qrText              String       @default("Scan to validate")
  barcodeText         String       @default("none")
  letterheadStyle     String       @default("none")
  paperSize           String       @default("A4")
  printOrientation    String       @default("portrait")
  customHeader1       String?
  customHeader2       String?
  customHeader3       String?
  customHeader4       String?
  deltaSettings       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt
  headerColumnGap     String       @default("2")
  showTestName        Boolean      @default(true)
  colWidthFlag        String?
  flagColorHigh       String       @default("#ef4444")
  flagColorLow        String       @default("#3b82f6")
  flagColorNormal     String       @default("#000000")
  flagStyle           String       @default("lh")
  separatePagesBy     String       @default("none")
  showFlagCol         Boolean      @default(true)
  tableHeaderRepeat   String       @default("test")
  bodyLineHeight      String       @default("1.5")
  testBlockSpacing    String       @default("mb-4")
  headerFontSize      String       @default("text-xs")
  headerFontWeight    String       @default("font-bold")
  headerRowHeight     String       @default("py-1.5")
  headerBorderRadius  String       @default("none")
  headerToBodyGap     String       @default("0")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model User {
  id                 Int              @id @default(autoincrement())
  username           String           @unique
  password           String
  name               String
  email              String?          @unique
  phone              String?
  organizationId     Int
  degree             String?
  signName           String?
  designation        String?
  regNumber          String?
  signText1          String?
  signText2          String?
  signatureUrl       String?
  isDefaultSignature Boolean          @default(false)
  allowConcession    Boolean          @default(false)
  concessionLimit    Float?           @default(0)
  isBillingOnly      Boolean          @default(false)
  roleId             Int?
  doctorId           Int?             @unique
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  isTwoFactorEnabled Boolean          @default(false)
  twoFactorSecret    String?
  approvedBills1     Bill[]           @relation("BillApprovedBy1")
  approvedBills2     Bill[]           @relation("BillApprovedBy2")
  doctor             Doctor?          @relation(fields: [doctorId], references: [id])
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role               Role?            @relation(fields: [roleId], references: [id])
  permissions        UserPermission[]
}

model Role {
  id             Int              @id @default(autoincrement())
  organizationId Int
  name           String
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  users          User[]

  @@unique([organizationId, name])
}

model Permission {
  id          Int              @id @default(autoincrement())
  module      String
  action      String
  description String?
  roles       RolePermission[]
  users       UserPermission[]

  @@unique([module, action])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Organism {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  antibiotics    Antibiotic[] @relation("AntibioticToOrganism")

  @@unique([organizationId, code])
}

model Antibiotic {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  group          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organisms      Organism[]   @relation("AntibioticToOrganism")

  @@unique([organizationId, code])
}

model AntibioticClass {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model AntibioticInterpretation {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model SusceptibilityInfo {
  id             Int          @id @default(autoincrement())
  organizationId Int
  code           String
  name           String
  details        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, otp])
}

model SupportThread {
  id             Int              @id @default(autoincrement())
  organizationId Int
  title          String
  status         String           @default("Open")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  type           String           @default("Issue")
  messages       SupportMessage[]
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SupportMessage {
  id               Int           @id @default(autoincrement())
  threadId         Int
  senderName       String
  isFromSuperAdmin Boolean       @default(false)
  content          String
  createdAt        DateTime      @default(now())
  thread           SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model WhatsAppAccount {
  id                   Int          @id @default(autoincrement())
  organizationId       Int
  businessAccountId    String?
  phoneNumberId        String?
  encryptedAccessToken String?
  displayName          String?
  status               String       @default("ACTIVE")
  templateName         String?
  failureCount         Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @default(now()) @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model WhatsAppLog {
  id                 Int          @id @default(autoincrement())
  organizationId     Int
  patientId          Int?
  billId             Int?
  phone              String
  category           String
  transport          String
  status             String
  pdfUrl             String?
  templateName       String?
  caption            String?
  metaMessageId      String?
  metaConversationId String?
  metaErrorCode      String?
  metaErrorMessage   String?
  metaTraceId        String?
  metaResponse       Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([billId])
  @@index([patientId])
}

model WhatsAppQueue {
  id                  Int          @id @default(autoincrement())
  organizationId      Int
  patientId           Int?
  billId              Int?
  phone               String
  category            String
  transport           String
  pdfUrl              String?
  templateName        String?
  caption             String?
  status              String       @default("PENDING")
  priority            Int          @default(0)
  retryCount          Int          @default(0)
  lastError           String?
  scheduledAt         DateTime     @default(now())
  processingStartedAt DateTime?
  completedAt         DateTime?
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status, scheduledAt])
}

model WhatsAppAuditLog {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int?
  action         String
  oldValue       Json?
  newValue       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}